# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next */
/.next-stale-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# credentials, local exports, and provider state
*.key
*.p12
*.pfx
*.log
.ssh/
.credentials/
secrets/
supabase/.temp/
supabase/.branches/
exports/
backups/

# internal review material; preserved locally, not published to GitHub
/legal-readiness-report.md
/design-qa/

# vercel
.vercel

# netlify
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts
