# Template only. Copy to .env.local and fill values locally; never commit secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave blank until the approved apps.apple.com listing is available.
NEXT_PUBLIC_APP_STORE_URL=

# Use the existing website Supabase project, not the mobile app database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ANALYTICS_HASH_SECRET=
ADMIN_LOGIN_USERNAME=
ADMIN_AUTH_EMAIL=
ADMIN_EMAIL_ALLOWLIST=
